<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kinseat.Service\Kinseat.Service.csproj" />
    <ProjectReference Include="..\Kinseat.Shared\Kinseat.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real release notes and a real releases response for the update-check tests. -->
    <Content Include="Updates\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped default config, so LoggingFilterTests can assert against the real file
         rather than a copy of it that could drift. -->
    <Content Include="..\Kinseat.Service\appsettings.json"
             Link="service-appsettings.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
